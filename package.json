{
  "name": "pdv-mercado",
  "version": "1.0.0",
  "description": "PDV Supermercado — frente de caixa desktop offline-first com NFC-e (SEFAZ-SP) e versão web para Vercel",
  "author": "Casa Ó",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env PDV_TARGET=web vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "build:win": "vite build && electron-builder --win nsis",
    "build:linux": "vite build && electron-builder --linux AppImage deb",
    "build:web": "cross-env PDV_TARGET=web vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx electron/db/seed.ts",
    "db:setup": "tsx server/setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:offline": "bash scripts/check-offline.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "optionalDependencies": {
    "@playwright/test": "^1.49.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.8.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.2.4",
    "koffi": "^2.10.0",
    "node-thermal-printer": "^4.4.4",
    "serialport": "^12.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
