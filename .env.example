# ---- PDV Mercado (web) ----
# Copie para .env.local (dev) e configure as MESMAS chaves na Vercel
# em Settings → Environment Variables.

# Postgres. Use a connection string POOLED do provedor (Neon, Supabase ou
# Vercel Postgres) — serverless abre muitas conexões curtas e a direta estoura
# o limite. Precisa de SSL: mantenha o ?sslmode=require.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo que assina o cookie de sessão. Gere um só seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desloga todo mundo.
SESSION_SECRET="troque-por-32-bytes-aleatorios-em-hex"
